<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="grassGrad5" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e5f38" />
      <stop offset="100%" stop-color="#0e381f" />
    </linearGradient>
    <pattern id="stripes5" width="90" height="500" patternUnits="userSpaceOnUse">
      <rect width="45" height="500" fill="#247846" opacity="0.25" />
      <rect x="45" width="45" height="500" fill="#185230" opacity="0.25" />
    </pattern>
  </defs>
  <rect width="800" height="500" fill="url(#grassGrad5)" />
  <rect width="800" height="500" fill="url(#stripes5)" />
  <rect x="45" y="35" width="710" height="430" fill="none" stroke="#ffffff" stroke-width="4" stroke-opacity="0.9" />
  <line x1="400" y1="35" x2="400" y2="465" stroke="#ffffff" stroke-width="4" stroke-opacity="0.9" />
  <circle cx="400" cy="250" r="75" fill="none" stroke="#ffffff" stroke-width="4" stroke-opacity="0.9" />
  <rect x="45" y="140" width="120" height="220" fill="none" stroke="#ffffff" stroke-width="4" stroke-opacity="0.9" />
  <rect x="635" y="140" width="120" height="220" fill="none" stroke="#ffffff" stroke-width="4" stroke-opacity="0.9" />
  <rect x="65" y="55" width="230" height="34" rx="6" fill="#0f172a" fill-opacity="0.85" />
  <text x="80" y="78" fill="#4ade80" font-family="'Segoe UI', sans-serif" font-weight="700" font-size="14">🌿 GREEN VALLEY ARENA</text>
