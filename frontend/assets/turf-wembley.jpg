<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="grassGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#134e2a" />
      <stop offset="100%" stop-color="#0a2a16" />
    </linearGradient>
    <pattern id="stripes2" width="60" height="500" patternUnits="userSpaceOnUse">
      <rect width="30" height="500" fill="#1b6336" opacity="0.35" />
      <rect x="30" width="30" height="500" fill="#124023" opacity="0.35" />
    </pattern>
  </defs>
  <rect width="800" height="500" fill="url(#grassGrad2)" />
  <rect width="800" height="500" fill="url(#stripes2)" />
  <rect x="40" y="30" width="720" height="440" fill="none" stroke="#ffffff" stroke-width="5" stroke-opacity="0.95" />
  <line x1="400" y1="30" x2="400" y2="470" stroke="#ffffff" stroke-width="5" stroke-opacity="0.95" />
  <circle cx="400" cy="250" r="85" fill="none" stroke="#ffffff" stroke-width="5" stroke-opacity="0.95" />
  <circle cx="400" cy="250" r="5" fill="#ffffff" />
  <rect x="40" y="125" width="140" height="250" fill="none" stroke="#ffffff" stroke-width="5" stroke-opacity="0.95" />
  <rect x="620" y="125" width="140" height="250" fill="none" stroke="#ffffff" stroke-width="5" stroke-opacity="0.95" />
  <circle cx="80" cy="40" r="140" fill="#ffffff" opacity="0.09" />
  <circle cx="720" cy="40" r="140" fill="#ffffff" opacity="0.09" />
  <rect x="60" y="50" width="230" height="34" rx="6" fill="#0f172a" fill-opacity="0.85" />
  <text x="75" y="73" fill="#38bdf8" font-family="'Segoe UI', sans-serif" font-weight="700" font-size="14">🏟️ WEMBLEY TURF PARK</text>
