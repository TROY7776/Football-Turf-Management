<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="grassGrad3" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#166534" />
      <stop offset="100%" stop-color="#0d3b1e" />
    </linearGradient>
    <pattern id="gridPat" width="50" height="50" patternUnits="userSpaceOnUse">
      <rect width="50" height="50" fill="none" stroke="#1f7a3f" stroke-width="1" opacity="0.3" />
    </pattern>
  </defs>
  <rect width="800" height="500" fill="url(#grassGrad3)" />
  <rect width="800" height="500" fill="url(#gridPat)" />
  <rect x="50" y="40" width="700" height="420" fill="none" stroke="#ffffff" stroke-width="4" stroke-opacity="0.85" />
  <line x1="400" y1="40" x2="400" y2="460" stroke="#ffffff" stroke-width="4" stroke-opacity="0.85" />
  <circle cx="400" cy="250" r="65" fill="none" stroke="#ffffff" stroke-width="4" stroke-opacity="0.85" />
  <rect x="50" y="150" width="110" height="200" fill="none" stroke="#ffffff" stroke-width="4" stroke-opacity="0.85" />
  <rect x="640" y="150" width="110" height="200" fill="none" stroke="#ffffff" stroke-width="4" stroke-opacity="0.85" />
  <rect x="70" y="60" width="240" height="34" rx="6" fill="#0f172a" fill-opacity="0.85" />
  <text x="85" y="83" fill="#facc15" font-family="'Segoe UI', sans-serif" font-weight="700" font-size="14">⚡ KICKOFF SPORTS GROUND</text>
</svg>
